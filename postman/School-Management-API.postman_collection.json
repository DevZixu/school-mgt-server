              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Login as teacher for results",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logged in\", () => pm.response.to.have.status(200));"
