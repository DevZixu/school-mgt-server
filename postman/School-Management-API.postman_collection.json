            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"StudentPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Student views own profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Student views own results",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/results"
          }
        },
        {
          "name": "Forbidden student write",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student write is forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
