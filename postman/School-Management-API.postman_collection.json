          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"TeacherPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Create result (teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('resultId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"score\": 87,\n  \"grade\": \"A\",\n  \"term\": \"Term 1\",\n  \"session\": \"2026/2027\"\n}"
            },
            "url": "{{baseUrl}}/api/results"
          }
        },
        {
          "name": "List students (teacher)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Update result (teacher)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 90,\n  \"grade\": \"A\"\n}"
            },
            "url": "{{baseUrl}}/api/results/{{resultId}}"
          }
        },
        {
          "name": "Get result (teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('teacher can view result', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/results/{{resultId}}"
          }
        },
        {
          "name": "Login as student for own records",
          "event": [
            {
              "listen": "test",
              "script": {
